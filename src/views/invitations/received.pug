extends ./layout.pug

block subContent

    div(class="search-bar-container")
        div(class="input-container")
            form(hx-get="/invitations/received" hx-target=".page")
                p(class="form-label") Search
                input.edit( type="text" name="searchTerm" placeholder="User name..." value=`${queryParams.searchTerm || ""}`)


    - if(invitations.length === 0)
        div(class="empty-list-container")
            img(src="/img/no-results.png" class="empty-inbox-img")
            p No pending invitations

    - else
        div(class="table-container")
            - for(let i = 0; i < invitations.length; i++)
                - const invitation = invitations[i];
                
                div(class="invitation")
                    div(class="invitation-left")
                        p(class="invitation-name") From: #{invitation.sender.userName}
                        p(class="invitation-description soft-text") #{invitation.sender.userName} invited you to join #{invitation.organization.name} as a #{invitation.userRole.role}
                    div(class="invitation-right")
                        button(class="invitation-name clickable text-hover" hx-post=`/invitations/accept/${invitation.id}` hx-target=".page") Accept

                - if(i < invitations.length - 1)
                    div(class="vertical-list-divider")
            
        div(class="pagination-container")
            div(class="pagination")
                - const curPage = pagination.curPage;
                - const pageNums = [curPage];
                
                - if(curPage > 1)
                    - pageNums.unshift(curPage - 1);
                - if(curPage < numPages)
                    - pageNums.push(curPage + 1);

                div(class="pagination-left")
                    - let hxGetLeftArrowUrl = `/invitations/received?curPage=${Math.max(curPage - 1, 1)}`;
                    - if(searchTerm) hxGetLeftArrowUrl += `&searchTerm=${searchTerm}`;
                    button(class="clickable text-hover" hx-get=hxGetLeftArrowUrl hx-target=".page") <

                div(class="pagination-center")
                    - for(const pageNum of pageNums)
                        - let className = "page-num clickable text-hover";
                        - if(pageNum === curPage)
                            - className += " current-page-num";
                        
                        - let hxGetPageUrl = `/invitations/received?curPage=${pageNum}`;
                        - if(searchTerm) hxGetPageUrl += `&searchTerm=${searchTerm}`;
                        p(class=className hx-get=hxGetPageUrl hx-target=".page") #{pageNum}

                div(class="pagination-left")
                    - let hxGetRightArrowUrl = `/invitations/received?curPage=${Math.min(curPage + 1, numPages)}`;
                    - if(searchTerm) hxGetRightArrowUrl += `&searchTerm=${searchTerm}`;
                    button(class="clickable text-hover" hx-get=hxGetRightArrowUrl hx-target=".page") >