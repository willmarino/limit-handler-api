extends ./main.pug

block content

    div(class="page-content")
        div(class="scroll")
            div(class="lobby")
                div(class="lobby-sidebar")
                    ul
                        li(class=`${(curPath.includes("/projects") ? "primary-color": "")}`)
                            p(class="clickable text-hover" hx-get="/projects" hx-target=".page") Projects
                        li(class=`${(curPath.includes("/organizations") ? "primary-color": "")}`)
                            p(class="clickable text-hover" hx-get="/organizations" hx-target=".page") Organizations
                        li(class=`${(curPath.includes("/invitations") ? "primary-color": "")}`)
                            p(class="clickable text-hover" hx-get="/invitations/received" hx-target=".page") Invitations

                block center